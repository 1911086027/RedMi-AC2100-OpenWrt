CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

# necessary
base-files=y
block-mount=y
ca-bundle=y
default-settings-chn=y
dnsmasq-full=y 
dropbear=y
firewall4=y
fstools=y
kmod-crypto-hw-eip93=y
kmod-gpio-button-hotplug=y
kmod-leds-gpio=y
kmod-nf-nathelper=y 
kmod-nf-nathelper-extra=y
kmod-nft-offload=y
libc=y
libgcc=y 
libustream-openssl=y
logd=y
luci-app-package-manager=y
luci-compat=y
luci-lib-base=y 
luci-lib-ipkg=y
luci-light=y
mtd=y
netifd=y
nftables=y 
odhcp6c=y
odhcpd-ipv6only=y
opkg=y
ppp=y
ppp-mod-pppoe=y
procd-ujail=y
uboot-envtools=y 
uci=y
uclient-fetch=y 
urandom-seed=y
urngd=y
wpad-openssl=y 
kmod-mt7603=y
kmod-mt7615-firmware=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_bash=y

# other
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_fstrim=y

# finalshell
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-top=y

# schoolnet
# RKP-IPID 模块
CONFIG_PACKAGE_kmod-ipt-u32=y
CONFIG_PACKAGE_iptables-mod-u32=y
CONFIG_PACKAGE_iptables-mod-filter=y
CONFIG_PACKAGE_kmod-rkp-ipid=y
# 防 TTL 检测
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
# 其它依赖
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y

# luci
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
